{
  "name": "gogrepoc-desktop",
  "version": "2.0.0",
  "description": "GOG Game Repository Manager - Desktop Application",
  "main": "main.js",
  "author": "GOGRepoc Contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:electron\"",
    "dev:backend": "cd .. && python -m uvicorn gogrepoc.api.main:app --reload --port 8000",
    "dev:electron": "NODE_ENV=development electron . --dev",
    "build": "npm run build:backend && npm run build:electron",
    "build:backend": "cd ../backend && pyinstaller gogrepoc.spec",
    "build:electron": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.gogrepoc.desktop",
    "productName": "GOGRepoc",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-log": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "concurrently": "^8.2.0"
  }
}
